TargetSim scenario 1
# 지그재그 기동 시나리오 - 60 s 축소
#
# 과제 명세 조건을 그대로 지킨다.
#   시뮬레이션 시간 60 s, 갱신 간격 0.1 s
#   플랫폼 32.0 / 126.0 / 0 m / 0 m/s
#   대함   32.125 / 126.03 / 0 m / 30 m/s / Yaw 270
#   대공   32.12 / 126.0 / 300 m / 200 m/s / Yaw 180
#
# 회전 지점을 위치로 기술한 궤적을, 엔진이 쓰는 시간 기반 기동표로 옮긴 것이다.
# 각 기동의 start/end 는 실제 Core 를 돌려 그 위치에 닿는 시각을 찾아 정한 값이다.
#
# ── 기동 범위를 줄인 이유 ──────────────────────────────────────────
# 처음 지시받은 회전 지점(대공 Lon 126.04 / 125.98, 대함 Lon 125.99 등)은
# 60 s 안에 들어가지 않는다.
#   대함  30 m/s x 60 s =  1,800 m  <  필요 4,049 m  (2.25 배 부족)
#   대공 200 m/s x 60 s = 12,000 m  <  필요 20,275 m (1.69 배 부족)
# 속도와 시간은 명세 조건이라 바꿀 수 없으므로, 궤적의 모양은 그대로 두고
# 출발점을 중심으로 크기만 줄였다.
#   대함 축척 0.5042 (= 60/119),  대공 축척 0.4788
# 그래서 아래 트리거 값은 지시받은 좌표가 아니라 그것을 축척한 값이다.
#
# 반대로 좌표를 그대로 두고 시간을 늘린 판은 같은 폴더의
# 시나리오_지그재그_기동_원본크기.tsim 이다 (시뮬레이션 시간 132.5 s).
# 두 파일의 차이는 "시간을 지키고 궤적을 줄였는가" 뿐이고 나머지는 같다.
#
# ── G 값 ───────────────────────────────────────────────────────────
# 크기를 줄이면 선회 반경도 같은 비율로 줄어야 모양이 유지되므로 G 가 커진다.
# "정해진 시간에 정확히 목표 각도만큼 돈다" 는 조건에서 역산했다.
#   G = (dYaw[rad] * V) / (g * T)      g = 9.80665
#   대함 44.95도 / 2.4 s -> |G| 1.000000  (선회 반경  92 m, 스텝당 1.87도)
#   대공 89.90도 / 3.9 s -> |G| 8.205060  (선회 반경 497 m, 스텝당 2.31도)
#   대공 마지막만 149.83도 / 6.5 s. 6.5 = 3.9 x 5/3 이라 G 는 같다.
# G 의 부호가 회전 방향이다 (+ 우선회 / - 좌선회).
#
# 0.1 s 격자 위에서는 회전각을 딱 45 / 90 / 150 도로 맞출 수 없다.
# 45도는 44.9504도, 90도는 89.9007도, 150도는 149.8333도가 된다.
# 부호가 번갈아 상쇄되어 누적 침로 오차는 0.1도 수준이다.

duration=60
step=0.1

platform=32.0,126.0,0,0,0,0,0

# ── 대함 표적 ──────────────────────────────────────────────────────
# Yaw 270(서) 로 출발해 남서 -> 서 -> 북서 -> 서 로 한 번 비켜 가는 지그재그.
# 좌우 대칭이다.
#   1) Lon <= 126.027479   -45 -> Yaw 225 남서
#   2) Lat <= 32.123739    +45 -> Yaw 270 서
#   3) Lon <= 126.017360   +45 -> Yaw 315 북서
#   4) Lat >= 32.124747    -45 -> Yaw 270 서
#   5) 나머지 시간 서진 (t=60 s 에 32.125000 / 126.012232)
#
#   - 출발 뒤 곧바로 꺾지 않고 0.002521 도 직진한 뒤 내려간다. 좌측 상단
#     직진 길이도 같은 0.002521 도라 좌우가 대칭이다.
#   - 4) 의 트리거가 32.125 가 아닌 것은, 회전하는 동안 계속 올라가서
#     32.125 에서 시작하면 그보다 높게 끝나기 때문이다. 선회 반경만큼 미리
#     꺾어야 출발 위도와 같은 높이로 수평이 된다.
#   - 가운데가 파인 깊이는 0.0015 도 (32.125 -> 32.1235).
target=32.125,126.03,0,30,0,0,270
maneuver=2,-1.000000,8.0,10.4
maneuver=2,1.000000,15.8,18.2
maneuver=2,1.000000,41.9,44.3
maneuver=2,-1.000000,49.7,52.1

# ── 대공 표적 ──────────────────────────────────────────────────────
# Yaw 180(남) 으로 출발해 남->동->남->서->남->동 의 왕복 훑기.
#   1) Lat <= 32.115076   -90 -> Yaw  90 동   (회전이 끝나는 Lat 32.110467)
#   2) Lon >= 126.019153  +90 -> Yaw 180 남
#   3) Lat <= 32.103488   +90 -> Yaw 270 서   (회전이 끝나는 Lat 32.098955)
#   4) Lon <= 125.990424  -90 -> Yaw 180 남
#   5) Lat <= 32.092073   -90 -> Yaw  90 동   (회전이 끝나는 Lat 32.087421)
#   6) Lon >= 126.007182  +150 -> Yaw 240 남서
#   7) 없음. 6) 회전이 끝나는 t=60.0 s 에 경로가 끝난다.
#
# 트리거 위도가 직진 위도와 다른 이유 — 회전하는 동안에도 계속 남진하므로
# 선회 반경(위도로 0.00448 도)만큼 미리 꺾어야 지정한 위도에서 수평이 된다.
# 트리거는 "회전을 시작할 위도", 괄호 안은 "직진을 시작할 위도" 다.
#
# 6) 은 90도가 아니라 150도다. 90도만 돌면 남향으로 끝나는데, 거기서 60도
# 더 돌아 남서향으로 끝나게 했다. 회전이 끝나는 순간이 60 s 라 그대로 종점이다.
#
# U 턴이 순수 반원이 아니라 가운데에 직선 남진 구간이 들어간다. 반원만으로는
# 위도가 2 x 선회반경 = 0.00896 도밖에 안 내려가는데 필요한 낙차는
# 0.01149 도(= 0.024 x 축척)라서다.
target=32.12,126.0,300,200,0,0,180
maneuver=2,-8.205060,2.8,6.7
maneuver=2,8.205060,13.3,17.2
maneuver=2,8.205060,18.6,22.5
maneuver=2,-8.205060,36.2,40.1
maneuver=2,-8.205060,41.5,45.4
maneuver=2,8.205060,53.5,60.0
