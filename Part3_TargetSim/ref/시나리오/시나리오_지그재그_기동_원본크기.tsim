TargetSim scenario 1
# 지그재그 기동 시나리오 - 원본 크기 (대공 기준)
#
# 대공 표적은 지시받은 회전 지점 좌표를 줄이지 않고 그대로 그린다.
# 대공이 마지막 회전을 끝내는 103.6 s 에 시뮬레이션이 끝나고, 대함은 같은
# 시각에 궤적이 끝나도록 모양 비율은 그대로 둔 채 0.7825 배로 줄였다.
# 시간을 뺀 나머지 명세 조건은 모두 그대로다.
#
#   시뮬레이션 시간 103.6 s   <- 과제 조건 60 s 에서 늘린 값, 여기만 다르다
#   갱신 간격      0.1 s
#   플랫폼 32.0 / 126.0 / 0 m / 0 m/s
#   대함   32.125 / 126.03 / 0 m / 30 m/s / Yaw 270
#   대공   32.12 / 126.0 / 300 m / 200 m/s / Yaw 180
#
# 짝이 되는 60 s 판은 UI 시나리오 프리셋 "기동 시연 (지그재그 기동 60 s)" 에 들어 있다.
# 그쪽은 60 s 를 지키려고 두 표적을 모두 0.48 ~ 0.50 배로 줄였고,
# 이 파일은 대공을 원본 크기로 두고 시간을 늘렸다.
#
# ── 왜 103.6 s 이고 대함만 줄였는가 ────────────────────────────────
# 거리 = 속도 x 시간이고 속도는 명세로 묶여 있으므로 궤적 길이가 시간을 정한다.
#   대공 20,735 m / 200 m/s = 103.6 s   <- 원본 크기 그대로
#   대함  3,978 m /  30 m/s = 132.5 s   <- 원본 크기면 28.9 s 가 더 든다
# 한 파일에 시뮬레이션 시간은 하나뿐이라, 두 표적이 같은 시각에 끝나려면
# 한쪽을 줄여야 한다. 대공의 선회 반경은
#   "Lat 32.052 직진 구간에서 150 도 돌아 Lat 32.0315 / Lon 126.020 에 닿는다"
# 는 조건 하나로 R = 1,222 m 에 고정되고, 반경이 고정되면 궤적 길이와 소요
# 시간도 함께 고정되어 대공은 줄일 여지가 없다. 그래서 대함을 줄였다.
#   대함 축척 0.782484 (= 103.6 / 132.5)
# 앞뒤 직진 : 침하 깊이 : 전체 폭 비율이 그대로라 모양은 같고 크기만 작다.
#
# ── G 값 ───────────────────────────────────────────────────────────
# 회전각을 정확히 45 / 90 / 150 도로 맞추는 쪽을 택했다. 그래서 G 는 딱
# 떨어지는 값이 아니라 역산 값이다.
#   G = (dYaw[rad] x V) / (g x T),  g = 9.80665
#   대함  45 도 / 3.8 s  -> |G| 0.632276  (선회 반경   145 m)
#   대공  90 도 / 9.6 s  -> |G| 3.337014  (선회 반경 1,222 m)
#   대공 150 도 / 16.0 s -> 각속도가 같으므로 G 도 같다
# G 의 부호가 회전 방향이다 (+ 우선회 / - 좌선회).
# 선회 시간도 0.1 s 격자 위에 있어야 해서 대함 선회 반경의 축척은 0.7917 로,
# 전체 축척 0.7825 와 1.2 % 어긋난다 (거리로 1.7 m 라 눈에 띄지 않는다).
#
# 각 기동의 start/end 는 실제 Core 를 돌려 지정한 지점에 닿는 시각을 찾은 값이다.
# 트리거 검출이 0.1 s 격자에 걸려 있어 지정 좌표와 최대 11 m 어긋난다.

duration=103.6
step=0.1

platform=32.0,126.0,0,0,0,0,0

# ── 대함 표적 ──────────────────────────────────────────────────────
# Yaw 270(서) 으로 출발해 남서 -> 서 -> 북서 -> 서 로 한 번 비켜 가는 지그재그.
# 좌우 대칭이고 가운데가 0.001953 도 (= 0.0025 x 0.7825) 파인다.
#   1) Lon <= 126.026088   -45 -> Yaw 225 남서
#   2) Lat <=  32.123444   +45 -> Yaw 270 서    (직진 위도 32.123047)
#   3) Lon <= 126.006197   +45 -> Yaw 315 북서
#   4) Lat >=  32.124600   -45 -> Yaw 270 서    (직진 위도 32.125000)
#   5) 나머지 시간 서진, t=103.6 s 에 32.125000 / 125.998701 도착
#
#   - 앞 직진 0.003912 도, 뒤 직진 0.003910 도라 좌우가 대칭이다.
#   - 2) 4) 의 트리거가 직진 위도와 다른 것은, 회전하는 동안에도 위도가
#     계속 변해서 지정 위도에서 꺾기 시작하면 그보다 더 가서 수평이 되기
#     때문이다. 선회 반경만큼(위도로 약 0.0004 도) 미리 꺾어야 한다.
#   - 원본 크기였다면 종점이 Lon 125.990 인데, 0.7825 배로 줄이면서
#     125.998701 이 되었다. 전체 폭이 0.040 도에서 0.031299 도로 준 것이다.
target=32.125,126.03,0,30,0,0,270
maneuver=2,-0.632276,12.4,16.2
maneuver=2,0.632276,22.4,26.2
maneuver=2,0.632276,77.5,81.3
maneuver=2,-0.632276,87.5,91.3

# ── 대공 표적 ──────────────────────────────────────────────────────
# Yaw 180(남) 으로 출발해 남 -> 동 -> 남 -> 서 -> 남 -> 남서 의 왕복 훑기.
# 지시받은 좌표 그대로다.
#   1) Lat <=  32.111042   -90 -> Yaw  90 동   (직진 위도 32.099960)
#   2) Lon >= 126.026988   +90 -> Yaw 180 남   (동쪽 끝 126.040094)
#   3) Lat <=  32.087071   +90 -> Yaw 270 서   (직진 위도 32.075931)
#   4) Lon <= 125.993139   -90 -> Yaw 180 남   (서쪽 끝 125.980099)
#   5) Lat <=  32.063165   -90 -> Yaw  90 동   (직진 위도 32.052082)
#   6) Lon >= 126.013450  +150 -> Yaw 240 남서 (도착 32.031514 / 126.020055)
#   7) 없음. 6) 회전이 끝나는 t=103.6 s 가 그대로 종점이다.
#
# 트리거는 "회전을 시작할 좌표", 괄호 안은 "회전이 끝나 직진이 시작되는 좌표" 다.
# 회전하는 동안에도 계속 움직이므로 선회 반경만큼 미리 꺾어야 지정한 좌표에서
# 수평이 된다. 위도로 약 0.0110 도, 경도로 약 0.0129 도 앞선다.
#
# 6) 은 90 도가 아니라 150 도다. 90 도만 돌면 남향으로 끝나는데 거기서 60 도
# 더 돌아 남서향으로 끝나게 했다.
#
# U 턴 가운데에 직선 남진 구간(217 m, 1.1 s)이 들어간다. 반원만으로는 위도가
# 2 x 선회반경 = 0.02205 도밖에 안 내려가는데 필요한 낙차는 0.024 도라서다.
target=32.12,126.0,300,200,0,0,180
maneuver=2,-3.337014,5.0,14.6
maneuver=2,3.337014,21.3,30.9
maneuver=2,3.337014,32.0,41.6
maneuver=2,-3.337014,57.7,67.3
maneuver=2,-3.337014,68.3,77.9
maneuver=2,3.337014,87.6,103.6
