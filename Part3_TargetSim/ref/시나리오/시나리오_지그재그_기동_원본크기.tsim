TargetSim scenario 1
# 지그재그 기동 시나리오 - 원본 크기, 116 s
#
# 지그재그를 60 s 에 맞춰 줄이지 않고 크게 그린 시나리오다.
# 대공은 지시받은 궤적에서 좌우 끝만 더 넓혔고, 대공이 마지막 회전을 끝내는
# 116.0 s 에 시뮬레이션이 끝난다. 대함은 같은 시각에 끝나도록 직진 세 구간을
# 같은 길이로 맞췄다. 시간을 뺀 나머지 명세 조건은 모두 그대로다.
#
#   시뮬레이션 시간 116.0 s   <- 과제 조건 60 s 에서 늘린 값, 여기만 다르다
#   갱신 간격      0.1 s
#   플랫폼 32.0 / 126.0 / 0 m / 0 m/s
#   대함   32.125 / 126.03 / 0 m / 30 m/s / Yaw 270
#   대공   32.12 / 126.0 / 300 m / 200 m/s / Yaw 180
#
# 짝이 되는 60 s 판은 UI 시나리오 프리셋 "응용 시나리오" 에 들어 있다.
# 그쪽은 60 s 를 지키려고 크기를 줄였다 (대공은 8 G 라 선회 반경이 이 파일의 절반).
# 이 파일의 값은 UI 프리셋 "응용 시나리오 (원본 크기)" 와 같다.
#
# ── 왜 116.0 s 인가 ────────────────────────────────────────────────
# 대공의 좌우 끝을 동쪽 126.043, 서쪽 125.970 으로 넓혔다 (지시 좌표는 126.040 / 125.980).
# 2) 회전을 1.4 s 늦춰 동쪽으로 더 가고, 180 도를 돈 뒤 서쪽 직진을 6.2 s 더 해서
# 서쪽 끝을 넓혔다. 넓어진 만큼 6) 회전까지의 동쪽 직진도 4.8 s 길어진다.
#   대공 23,200 m / 200 m/s = 116.0 s
#   대함  3,480 m /  30 m/s = 116.0 s   <- 대공과 같은 시각에 끝나도록 맞춤
# 대함이 지시 종점 Lon 125.990 까지 가려면 약 133 s 가 필요해서, 116.0 s 에는
# Lon 125.995396 까지 간다.
#
# ── G 값 ───────────────────────────────────────────────────────────
# G 는 정수로 정하고, 회전 시간을 0.1 s 단위로 맞춰 회전각이 45 / 90 / 150 도에
# 가깝게 했다.
#   회전 시간 T = (dYaw[rad] x V) / (G x g),  g = 9.80665
#   대함 1 G,  45 도 ->  2.4 s  (44.95 도, 선회 반경    92 m)
#   대공 4 G,  90 도 ->  8.0 s  (89.90 도, 선회 반경 1,020 m)
#   대공 4 G, 150 도 -> 13.4 s  (150.58 도)
# G 의 부호가 회전 방향이다 (+ 우선회 / - 좌선회).
#
# 각 기동의 start/end 는 실제 Core 를 돌려 정한 시각이고, 아래 좌표는 그 시각에
# Core 가 계산한 위치다.

duration=116.0
step=0.1

platform=32.0,126.0,0,0,0,0,0

# ── 대함 표적 ──────────────────────────────────────────────────────
# Yaw 270(서) 으로 출발해 남서 -> 서 -> 북서 -> 서 로 한 번 비켜 가는 지그재그.
# 좌우 대칭이고 가운데가 0.0025 도 파인다. 직진 세 구간의 길이가 같다.
#   1) Lon <= 126.020971   -45 -> Yaw 225 남서
#   2) Lat <=  32.122732   +45 -> Yaw 270 서    (직진 위도 32.122490)
#   3) Lon <= 126.008183   +45 -> Yaw 315 북서
#   4) Lat >=  32.124758   -45 -> Yaw 270 서    (직진 위도 32.125000)
#   5) 나머지 시간 서진, t=116.0 s 에 32.125000 / 125.995396 도착
#
#   - 직진 세 구간은 0 ~ 28.4 s, 43.8 ~ 72.2 s, 87.6 ~ 116.0 s 로 28.4 s (852 m,
#     경도 0.009029 도) 씩 같다. 대각선 두 구간도 10.6 s 씩 같다.
#   - 2) 4) 의 트리거가 직진 위도와 다른 것은, 회전하는 동안에도 위도가
#     계속 변해서 지정 위도에서 꺾기 시작하면 그보다 더 가서 수평이 되기
#     때문이다. 선회 반경만큼(위도로 약 0.0002 도) 미리 꺾어야 한다.
#   - 지시 종점 Lon 125.990 까지는 약 133 s 가 걸려서, 116.0 s 에 맞추면
#     125.995396 까지 간다. 전체 폭이 0.040 도에서 0.034604 도가 된 것이다.
target=32.125,126.03,0,30,0,0,270
maneuver=2,-1.0,28.4,30.8
maneuver=2,1.0,41.4,43.8
maneuver=2,1.0,72.2,74.6
maneuver=2,-1.0,85.2,87.6

# ── 대공 표적 ──────────────────────────────────────────────────────
# Yaw 180(남) 으로 출발해 남 -> 동 -> 남 -> 서 -> 남 -> 남서 의 왕복 훑기.
# 직진 위도는 지시받은 좌표 그대로이고 (5 m 안), 좌우 끝만 넓혔다.
#   1) Lat <=  32.109179   -90 -> Yaw  90 동   (직진 위도 32.099983)
#   2) Lon >= 126.032184   +90 -> Yaw 180 남   (동쪽 끝 126.042968)
#   3) Lat <=  32.085165   +90 -> Yaw 270 서   (직진 위도 32.075970)
#   4) Lon <= 125.980714   -90 -> Yaw 180 남   (서쪽 끝 125.969933)
#   5) Lat <=  32.061287   -90 -> Yaw  90 동   (직진 위도 32.052092)
#   6) Lon >= 126.014806  +150 -> Yaw 240 남서 (도착 32.034828 / 126.020074)
#   7) 없음. 6) 회전이 끝나는 t=116.0 s 가 그대로 종점이다.
#
# 트리거는 "회전을 시작할 좌표", 괄호 안은 "회전이 끝나 직진이 시작되는 좌표" 다.
# 회전하는 동안에도 계속 움직이므로 선회 반경만큼 미리 꺾어야 지정한 좌표에서
# 수평이 된다. 위도로 약 0.0092 도, 경도로 약 0.0108 도 앞선다.
#
# 6) 은 90 도가 아니라 150 도다. 90 도만 돌면 남향으로 끝나는데 거기서 60 도
# 더 돌아 남서향으로 끝나게 했다. 도착 지점은 지시 좌표 (32.0315 / 126.020) 보다
# 약 370 m 북쪽이다. 4 G 의 선회 반경이 지시 좌표로 정해지는 반경 1,222 m 보다
# 작아서다.
#
# U 턴 가운데에 직선 남진 구간(동쪽 3.1 s, 서쪽 3.0 s, 약 600 m)이 들어간다.
# 반원만으로는 위도가 2 x 선회반경 = 0.0184 도밖에 안 내려가는데 필요한 낙차는
# 0.024 도라서다.
target=32.12,126.0,300,200,0,0,180
maneuver=2,-4.0,6.0,14.0
maneuver=2,4.0,24.1,32.1
maneuver=2,4.0,35.2,43.2
maneuver=2,-4.0,67.5,75.5
maneuver=2,-4.0,78.5,86.5
maneuver=2,4.0,102.6,116.0
