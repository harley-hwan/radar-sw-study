    LTEXT           "스캔당 클러터",IDC_PCS_CLUTTER_LABEL,94,416,52,12,SS_NOPREFIX | SS_CENTERIMAGE
    EDITTEXT        IDC_PCS_CLUTTER,148,415,24,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "플롯 표시",IDC_PCS_SHOW_PLOT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,180,416,44,12
    CONTROL         "클러터 표시",IDC_PCS_SHOW_CLUTTER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,228,416,52,12
    LTEXT           "",IDC_PCS_SUMMARY,8,434,340,24,SS_NOPREFIX

    CONTROL         "",IDC_PLOT,"Static",SS_LEFT,356,34,396,250
    LTEXT           "결과 (LLA)",IDC_RESULT_TITLE,356,292,44,12,SS_NOPREFIX | SS_CENTERIMAGE
