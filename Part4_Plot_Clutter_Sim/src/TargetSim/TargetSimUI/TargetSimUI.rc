    CONTROL         "비중점법 비교",IDC_RESULT_COMPARE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,466,292,64,12
    CONTROL         "플랫폼 기준 비교",IDC_RESULT_PLATFORM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,534,292,72,12
    PUSHBUTTON      "CSV 저장...",IDC_SAVE_CSV,672,290,80,14
    CONTROL         "",IDC_RESULT_LIST,"SysListView32",LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP,356,308,396,154
END

