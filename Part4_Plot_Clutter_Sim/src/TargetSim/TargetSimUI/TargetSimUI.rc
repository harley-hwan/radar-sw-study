    PUSHBUTTON      "삭제",IDC_OBJ_DELETE,296,32,36,14
    CONTROL         "",IDC_OBJ_GRID,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP,8,50,340,150

    LTEXT           "기동",IDC_MNV_TITLE,8,208,200,12,SS_NOPREFIX | SS_CENTERIMAGE
    PUSHBUTTON      "기동 추가",IDC_MNV_ADD,248,206,44,14
    PUSHBUTTON      "삭제",IDC_MNV_DELETE,296,206,36,14
    CONTROL         "",IDC_MNV_GRID,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP,8,224,340,136
    LTEXT           "G 부호가 회전 방향 (Roll+ 우측 뱅크, Yaw+ 우선회, Pitch+ 기수 상승). 구간은 [시작, 종료)",IDC_MNV_HINT,8,364,340,10,SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "숫자 칸은 두 번 클릭, 축 칸은 한 번 클릭해 편집. Enter 확정, Esc 취소",IDC_EDIT_HINT,8,376,340,10,SS_NOPREFIX | SS_ENDELLIPSIS

    LTEXT           "측정 모의 (과제 4)",IDC_PCS_TITLE,8,398,200,12,SS_NOPREFIX | SS_CENTERIMAGE
    PUSHBUTTON      "난수 확인...",IDC_PCS_RAND,288,396,60,14
    LTEXT           "SNR (선형)",IDC_PCS_SNR_LABEL,8,416,40,12,SS_NOPREFIX | SS_CENTERIMAGE
